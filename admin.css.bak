/* Admin Panel Styles - Matching GPON Generator Theme */
:root {
  --bg-primary: #0f172a;
  --bg-secondary: #1e293b;
  --bg-tertiary: #334155;
  --text-primary: #f8fafc;
  --text-secondary: #94a3b8;
  --text-muted: #64748b;
  --accent-blue: #3b82f6;
  --accent-blue-hover: #2563eb;
  --accent-green: #10b981;
  --accent-red: #ef4444;
  --accent-yellow: #f59e0b;
  --accent-purple: #8b5cf6;
  --border-color: #334155;
  --card-bg: rgba(30, 41, 59, 0.7);
  --shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3), 0 8px 10px -6px rgba(0, 0, 0, 0.3);
  --radius: 12px;
  --radius-sm: 6px;
  --font-main: 'Inter', system-ui, -apple-system, sans-serif;
  --font-code: 'JetBrains Mono', monospace;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-main);
  background-color: var(--bg-primary);
  color: var(--text-primary);
  min-height: 100vh;
  line-height: 1.5;
  padding: 20px;
}

.admin-container {
  max-width: 1400px;
  margin: 0 auto;
}

/* Header */
.admin-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  padding: 20px 28px;
  border-radius: var(--radius);
  margin-bottom: 24px;
  box-shadow: var(--shadow);
}

.admin-title {
  display: flex;
  align-items: center;
  gap: 12px;
}

.admin-title h1 {
  font-size: 1.5rem;
  font-weight: 700;
  background: linear-gradient(135deg, #60a5fa, #a78bfa);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.admin-title i {
  color: var(--accent-blue);
  font-size: 1.5rem;
}

.back-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--bg-tertiary);
  color: var(--text-primary);
  padding: 10px 18px;
  border-radius: var(--radius-sm);
  text-decoration: none;
  font-weight: 500;
  font-size: 0.9rem;
  transition: all 0.2s ease;
  border: 1px solid var(--border-color);
}

.back-btn:hover {
  background: var(--accent-blue);
  border-color: var(--accent-blue);
  transform: translateY(-1px);
}

/* Navigation Tabs */
.admin-tabs {
  display: flex;
  gap: 8px;
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  padding: 8px;
  border-radius: var(--radius);
  margin-bottom: 24px;
  overflow-x: auto;
}

.tab-btn {
  display: flex;
  align-items: center;
  gap: 10px;
  background: transparent;
  border: none;
  color: var(--text-secondary);
  padding: 12px 20px;
  font-size: 0.95rem;
  font-weight: 500;
  border-radius: var(--radius-sm);
  cursor: pointer;
  white-space: nowrap;
  transition: all 0.2s ease;
}

.tab-btn:hover {
  color: var(--text-primary);
  background: rgba(255, 255, 255, 0.05);
}

.tab-btn.active {
  background: var(--accent-blue);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
}

/* Content Area */
.admin-content {
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: var(--radius);
  padding: 28px;
  box-shadow: var(--shadow);
}

.tab-panel {
  display: none;
}

.tab-panel.active {
  display: block;
}

/* Toolbars & Controls */
.panel-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 24px;
  flex-wrap: wrap;
}

.search-box {
  position: relative;
  flex: 1;
  min-width: 260px;
}

.search-box i {
  position: absolute;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-muted);
}

.search-box input {
  width: 100%;
  background: var(--bg-primary);
  border: 1px solid var(--border-color);
  color: var(--text-primary);
  padding: 10px 14px 10px 40px;
  border-radius: var(--radius-sm);
  font-size: 0.95rem;
  outline: none;
}

.search-box input:focus {
  border-color: var(--accent-blue);
}

.filter-group {
  display: flex;
  gap: 6px;
}

.filter-btn {
  background: var(--bg-tertiary);
  border: 1px solid var(--border-color);
  color: var(--text-secondary);
  padding: 8px 16px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  font-size: 0.85rem;
  font-weight: 500;
}

.filter-btn.active {
  background: var(--accent-blue);
  color: #fff;
  border-color: var(--accent-blue);
}

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 20px;
  border-radius: var(--radius-sm);
  font-weight: 500;
  font-size: 0.9rem;
  cursor: pointer;
  border: none;
  transition: all 0.2s ease;
}

.btn-primary {
  background: var(--accent-blue);
  color: #fff;
}
.btn-primary:hover {
  background: var(--accent-blue-hover);
}

.btn-success {
  background: var(--accent-green);
  color: #fff;
}
.btn-success:hover {
  background: #059669;
}

.btn-danger {
  background: var(--accent-red);
  color: #fff;
}
.btn-danger:hover {
  background: #dc2626;
}

.btn-warning {
  background: var(--accent-yellow);
  color: #000;
}

.btn-secondary {
  background: var(--bg-tertiary);
  color: var(--text-primary);
  border: 1px solid var(--border-color);
}
.btn-secondary:hover {
  background: #475569;
}

.btn-sm {
  padding: 6px 12px;
  font-size: 0.8rem;
}

/* Table Styles */
.data-table-wrapper {
  overflow-x: auto;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-sm);
}

.data-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  font-size: 0.9rem;
}

.data-table th, .data-table td {
  padding: 14px 18px;
  border-bottom: 1px solid var(--border-color);
}

.data-table th {
  background: rgba(15, 23, 42, 0.6);
  color: var(--text-secondary);
  font-weight: 600;
  text-transform: uppercase;
  font-size: 0.75rem;
  letter-spacing: 0.05em;
}

.data-table tr:hover {
  background: rgba(255, 255, 255, 0.02);
}

/* Badges */
.badge {
  display: inline-block;
  padding: 4px 10px;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
}

.badge-adsl { background: rgba(245, 158, 11, 0.2); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.4); }
.badge-fttb { background: rgba(59, 130, 246, 0.2); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.4); }
.badge-gpon { background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.4); }

/* Form Controls & Modals */
.form-group {
  margin-bottom: 18px;
}

.form-group label {
  display: block;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 6px;
}

.form-control, .form-select {
  width: 100%;
  background: var(--bg-primary);
  border: 1px solid var(--border-color);
  color: var(--text-primary);
  padding: 10px 14px;
  border-radius: var(--radius-sm);
  font-size: 0.95rem;
  font-family: inherit;
  outline: none;
}

.form-control:focus, .form-select:focus {
  border-color: var(--accent-blue);
}

textarea.form-control {
  font-family: var(--font-code);
  font-size: 0.88rem;
  line-height: 1.6;
  resize: vertical;
  min-height: 160px;
}

/* Placeholder Toolbar */
.placeholder-toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 10px;
  padding: 8px 12px;
  background: var(--bg-primary);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-sm);
}

.chip-btn {
  background: var(--bg-tertiary);
  color: var(--accent-blue);
  border: 1px solid rgba(59, 130, 246, 0.3);
  padding: 4px 10px;
  border-radius: 4px;
  font-family: var(--font-code);
  font-size: 0.78rem;
  cursor: pointer;
  transition: all 0.15s ease;
}

.chip-btn:hover {
  background: var(--accent-blue);
  color: #fff;
}

/* Grid splits */
.grid-split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}

@media (max-width: 900px) {
  .grid-split {
    grid-template-columns: 1fr;
  }
}

.preview-box {
  background: var(--bg-primary);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-sm);
  padding: 16px;
}

.preview-header {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.preview-code {
  font-family: var(--font-code);
  font-size: 0.85rem;
  color: #38bdf8;
  white-space: pre-wrap;
  background: #090d16;
  padding: 14px;
  border-radius: 6px;
  max-height: 350px;
  overflow-y: auto;
}

/* Modals */
.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
}

.modal-overlay.open {
  opacity: 1;
  pointer-events: auto;
}

.modal-card {
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: var(--radius);
  width: 100%;
  max-width: 750px;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: var(--shadow);
  padding: 28px;
}

.modal-card-xl {
  max-width: 1200px;
  width: 95vw;
}

/* Sub-tabs inside Manager Modal */
.sub-tabs {
  display: flex;
  gap: 8px;
  border-bottom: 1px solid var(--border-color);
  margin-bottom: 20px;
}

.sub-tab-btn {
  background: transparent;
  border: none;
  border-bottom: 2px solid transparent;
  color: var(--text-secondary);
  padding: 10px 18px;
  font-size: 0.95rem;
  font-weight: 500;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: all 0.2s ease;
}

.sub-tab-btn:hover {
  color: var(--text-primary);
}

.sub-tab-btn.active {
  color: var(--accent-blue);
  border-bottom-color: var(--accent-blue);
  font-weight: 600;
}

.subtab-panel {
  display: none;
}

.subtab-panel.active {
  display: block;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
  border-bottom: 1px solid var(--border-color);
  padding-bottom: 14px;
}

.modal-title {
  font-size: 1.2rem;
  font-weight: 600;
}

.modal-close {
  background: transparent;
  border: none;
  color: var(--text-muted);
  font-size: 1.2rem;
  cursor: pointer;
}

.modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  margin-top: 24px;
  border-top: 1px solid var(--border-color);
  padding-top: 18px;
}

/* Toast Notifications */
.toast-container {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.toast {
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-left: 4px solid var(--accent-blue);
  padding: 12px 20px;
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow);
  color: var(--text-primary);
  font-size: 0.9rem;
  display: flex;
  align-items: center;
  gap: 10px;
}

.toast.success { border-left-color: var(--accent-green); }
.toast.error { border-left-color: var(--accent-red); }

.hidden {
  display: none !important;
}

/* Authentication Screen */
.auth-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(15, 23, 42, 0.96);
  backdrop-filter: blur(12px);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.auth-card {
  background: #1e293b;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 16px;
  padding: 36px 32px;
  width: 90%;
  max-width: 400px;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
  text-align: center;
}

.auth-icon {
  font-size: 2.5rem;
  color: var(--accent-blue);
  margin-bottom: 16px;
}

.auth-header h2 {
  font-size: 1.4rem;
  margin-bottom: 6px;
  color: #fff;
}

.auth-header p {
  color: var(--text-muted);
  font-size: 0.88rem;
  margin-bottom: 24px;
}

.input-with-icon {
  position: relative;
  display: flex;
  align-items: center;
}

.input-with-icon i {
  position: absolute;
  left: 14px;
  color: var(--text-muted);
}

.input-with-icon input {
  padding-left: 40px;
  width: 100%;
}

.btn-block {
  width: 100%;
  margin-top: 16px;
  padding: 12px;
  font-size: 1rem;
  justify-content: center;
}

.auth-error {
  background: rgba(239, 68, 68, 0.15);
  border: 1px solid rgba(239, 68, 68, 0.4);
  color: #f87171;
  padding: 10px;
  border-radius: 8px;
  font-size: 0.85rem;
  margin-top: 12px;
}

/* ==========================================================================
   Equipment Notes Editor & Markdown Preview Styles
   ========================================================================== */

.notes-editor-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-top: 8px;
}

@media (max-width: 900px) {
  .notes-editor-layout {
    grid-template-columns: 1fr;
  }
}

.notes-editor-col {
  display: flex;
  flex-direction: column;
}

.markdown-toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4px;
  padding: 8px 10px;
  background: rgba(15, 23, 42, 0.75);
  border: 1px solid var(--border-color);
  border-bottom: none;
  border-radius: var(--radius-sm) var(--radius-sm) 0 0;
}

.md-tool-btn {
  background: transparent;
  border: 1px solid transparent;
  color: var(--text-secondary);
  padding: 5px 8px;
  border-radius: 4px;
  font-size: 0.78rem;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  transition: all 0.2s ease;
}

.md-tool-btn:hover {
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
  border-color: rgba(255, 255, 255, 0.15);
}

.md-tool-sep {
  width: 1px;
  height: 18px;
  background: var(--border-color);
  margin: 0 4px;
}

.notes-textarea {
  border-top-left-radius: 0;
  border-top-right-radius: 0;
  font-family: 'JetBrains Mono', Consolas, monospace;
  font-size: 0.86rem;
  line-height: 1.5;
  resize: vertical;
  min-height: 320px;
  background: var(--bg-primary);
}

.notes-preview-col {
  display: flex;
  flex-direction: column;
  background: var(--bg-primary);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-sm);
  overflow: hidden;
  max-height: 480px;
}

.preview-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 16px;
}

/* Rendered Notes Typography & Markdown Components */
.device-notes-rendered {
  font-size: 0.9rem;
  line-height: 1.6;
  color: var(--text-primary);
}

.device-notes-rendered h1,
.device-notes-rendered h2,
.device-notes-rendered h3,
.device-notes-rendered h4 {
  color: #fff;
  margin-top: 14px;
  margin-bottom: 8px;
  font-weight: 600;
}

.device-notes-rendered h1 { font-size: 1.25rem; border-bottom: 1px solid var(--border-color); padding-bottom: 4px; }
.device-notes-rendered h2 { font-size: 1.15rem; }
.device-notes-rendered h3 { font-size: 1.05rem; color: var(--accent-blue); }
.device-notes-rendered h4 { font-size: 0.95rem; }

.device-notes-rendered p {
  margin-bottom: 10px;
}

.device-notes-rendered ul,
.device-notes-rendered ol {
  padding-left: 22px;
  margin-bottom: 12px;
}

.device-notes-rendered li {
  margin-bottom: 4px;
}

.device-notes-rendered code.inline-code {
  background: rgba(30, 41, 59, 0.8);
  color: #38bdf8;
  padding: 2px 6px;
  border-radius: 4px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.84rem;
  border: 1px solid rgba(56, 189, 248, 0.25);
}

.device-notes-rendered .code-block-wrapper {
  margin: 12px 0;
  background: #090d16;
  border: 1px solid var(--border-color);
  border-radius: 8px;
  overflow: hidden;
}

.device-notes-rendered .code-block-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6px 12px;
  background: rgba(30, 41, 59, 0.6);
  font-size: 0.75rem;
  color: var(--text-muted);
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.device-notes-rendered .btn-copy-code {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: var(--text-secondary);
  padding: 2px 8px;
  border-radius: 4px;
  font-size: 0.72rem;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  transition: all 0.2s;
}

.device-notes-rendered .btn-copy-code:hover {
  color: #fff;
  background: rgba(255, 255, 255, 0.15);
}

.device-notes-rendered pre {
  margin: 0;
  padding: 12px 14px;
  font-family: 'JetBrains Mono', Consolas, monospace;
  font-size: 0.85rem;
  color: #e2e8f0;
  line-height: 1.5;
  overflow-x: auto;
  white-space: pre-wrap;
}

.device-notes-rendered .note-alert {
  padding: 10px 14px;
  border-radius: 6px;
  margin: 12px 0;
  font-size: 0.88rem;
  display: flex;
  align-items: flex-start;
  gap: 10px;
  line-height: 1.5;
}

.device-notes-rendered .note-alert-warning {
  background: rgba(245, 158, 11, 0.12);
  border-left: 4px solid #f59e0b;
  color: #fde68a;
}

.device-notes-rendered .note-alert-info {
  background: rgba(59, 130, 246, 0.12);
  border-left: 4px solid #3b82f6;
  color: #bfdbfe;
}

.device-notes-rendered .note-alert-tip {
  background: rgba(16, 185, 129, 0.12);
  border-left: 4px solid #10b981;
  color: #a7f3d0;
}

.device-notes-rendered table {
  width: 100%;
  border-collapse: collapse;
  margin: 12px 0;
  font-size: 0.85rem;
}

.device-notes-rendered th,
.device-notes-rendered td {
  padding: 6px 12px;
  border: 1px solid var(--border-color);
  text-align: left;
}

.device-notes-rendered th {
  background: rgba(30, 41, 59, 0.7);
  color: var(--text-secondary);
}

.badge-has-notes {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  margin-left: 6px;
  padding: 2px 6px;
  background: rgba(16, 185, 129, 0.15);
  color: #34d399;
  border: 1px solid rgba(16, 185, 129, 0.3);
  border-radius: 12px;
  font-size: 0.72rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s;
}

.badge-has-notes:hover {
  background: rgba(16, 185, 129, 0.3);
  color: #fff;
}

